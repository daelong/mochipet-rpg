{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noEmit": true, "skipLibCheck": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true, "types": ["vite/client", "node"],
    "paths": {"@mochi/shared": ["./packages/shared/src/index.ts"], "@mochi/game-data": ["./packages/game-data/src/index.ts"]}
  },
  "include": ["apps/web/src", "apps/web/tests", "packages", "tools", "*.ts"]
}
