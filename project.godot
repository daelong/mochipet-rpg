config_version=5

[application]
config/name="MochiPet Desktop Hunt"
config/version="0.4.1-review"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="MochiPetRPG/desktop-v041"

[display]
window/size/viewport_width=960
window/size/viewport_height=720
window/size/window_width_override=960
window/size/window_height_override=720
window/size/transparent=false
window/per_pixel_transparency/allowed=true
window/size/borderless=false
window/size/always_on_top=false
window/subwindows/embed_subwindows=false
window/vsync/vsync_mode=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.10, 0.12, 0.18, 1)

[debug]
file_logging/enable_file_logging=false
file_logging/enable_file_logging.pc=false
file_logging/log_path="user://logs/game.log"
file_logging/max_log_files=3

[gui]
theme/default_font_size=16

[mochi]
; Keep disabled until Windows/macOS native-window tests have been completed.
experimental_desktop_overlay=false
