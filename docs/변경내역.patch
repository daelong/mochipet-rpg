+    & $GodotExe @Arguments 2>&1 | Tee-Object -FilePath $Log
+    $Result = $LASTEXITCODE
+    if ($Result -ne 0) { throw "Godot failed ($Result): $LogName" }
+    if (Select-String -Path $Log -Pattern 'SCRIPT ERROR:|Parse Error:|ERROR:' -Quiet) {
+        throw "Godot reported errors: $LogName"
